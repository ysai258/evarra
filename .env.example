# EVARRA? needs no credentials: the dataset is built entirely from the public
# Wikidata and Wikimedia Commons APIs, neither of which requires an API key.
#
# Optional — identifies the ingestion scripts to Wikimedia. Their User-Agent policy
# asks for a contact address on automated traffic. Defaults to a generic UA.
# DATASET_CONTACT=you@example.com

# Optional — the game's first puzzle day, and the floor of the playable archive.
# Defaults to the first date already in src/data/puzzles.json, so regenerating the
# schedule later never moves the launch date forward. Only set this to move it
# deliberately.
# LAUNCH_DATE=2026-09-13

# Optional — where `npm run qa` points its browser. Defaults to localhost:5173.
# QA_URL=http://localhost:5173

# --- Multiplayer -----------------------------------------------------------
#
# Multiplayer needs a running process; the daily game does not. Everything below
# is optional, and with none of it set the daily game builds and plays exactly as
# it always has.

# Where the browser should look for the room server. In `npm run dev` this defaults
# to http://localhost:8787, so local play needs nothing here. A production build
# with this unset simply reports that multiplayer is unavailable.
# VITE_MULTIPLAYER_URL=https://rooms.example.com

# Which port the room server listens on. Defaults to 8787.
# MULTIPLAYER_PORT=8787

# Comma-separated origins allowed to connect. Unset means any, which is right for a
# dev machine and wrong for a public one — set it when you deploy.
# MULTIPLAYER_ORIGINS=https://ysai258.github.io
